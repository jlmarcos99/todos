{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.ts", "app/src/**/*.ts", "app/tests/**/*.ts", "sync/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
